{
	"schemaVersion": 1,
	"id": "terf-recipes",
	"version": "${version}",
	"name": "TERF Recipes",
	"description": "Shows the recipes, custom items, fluids and multiblock structures of the TERF datapack in JEI, with a 3D structure viewer and in-world build holograms. TERF datapack by jona23.",
	"authors": [
		"Hand1er0ne"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/terf-recipes"
	},
	"license": "ARR",
	"icon": "assets/terf-recipes/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.terfrecipes.TERFRecipes"
		],
		"client": [
			"com.terfrecipes.client.TERFRecipesClient"
		],
		"jei_mod_plugin": [
			"com.terfrecipes.client.jei.TerfJeiPlugin"
		],
		"fabric-datagen": [
			"com.terfrecipes.client.TERFRecipesDataGenerator"
		]
	},
	"mixins": [
		"terf-recipes.mixins.json",
		{
			"config": "terf-recipes.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"jei": "*"
	}
}